project UDP_Frag is
   for Source_Dirs use ("src");
   for Object_Dir  use "obj";
   for Exec_Dir    use "bin";
   for Main        use ("udp_frag_send.adb", "udp_frag_recv.adb");

   --  For VxWorks 7 RTPs with GNAT Pro, e.g.:
   --    for Target  use "aarch64-wrs-vxworks7r2";
   --    for Runtime ("Ada") use "rtp";
   --  or pass --target= / --RTS= to gprbuild.

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2012", "-gnatwa", "-gnatVa", "-gnata", "-gnato", "-O1", "-g");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;
end UDP_Frag;
